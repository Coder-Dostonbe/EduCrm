# ── Django ───────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ─────────────────────────────────────────────────────────
# Leave DATABASE_URL empty to fall back to SQLite (handy for a quick start).
# Docker Compose sets this automatically.
DATABASE_URL=postgres://eduflow:eduflow@localhost:5432/eduflow

# ── CORS (the Next.js frontend) ───────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── JWT lifetimes ────────────────────────────────────────────────────
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# ── Google OAuth ─────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# The frontend sends the Google ID token to /api/auth/google/
GOOGLE_OAUTH_CLIENT_ID=
# Domain restriction for sign-in (optional, e.g. eduflow.uz)
GOOGLE_ALLOWED_DOMAIN=
